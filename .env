APP_ENV=local

# =========================
# DATABASE - LOCAL
# =========================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=root
DB_PASSWORD=

# =========================
# DATABASE - PRODUCTION
# =========================
PROD_DB_CONNECTION=mysql
PROD_DB_HOST=your_production_host
PROD_DB_PORT=3306
PROD_DB_DATABASE=your_production_db
PROD_DB_USERNAME=your_production_user
PROD_DB_PASSWORD=your_production_password

# =========================
# SMTP CONFIG
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Cattle Management System"